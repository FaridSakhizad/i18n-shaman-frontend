{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "i18nshaman-tracking",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://i18nshaman.com"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "i18nshaman_product_events"
    }
  ]
}

